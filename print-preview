        bar.pack_start(Gtk.Label(label="Copies", margin_start=6), False, False, 0)
        bar.pack_start(self.spin, False, False, 0)
        bar.pack_start(self.more, False, False, 0)
        bar.pack_end(self.print_btn, False, False, 0)
        bar.pack_end(cancel, False, False, 0)
        main.pack_start(bar, False, False, 0)
        outer.pack_start(main, True, True, 0)

        side_wrap = self.side = Gtk.Box(no_show_all=True)
        side_wrap.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, width_request=self.SIDE - 32, margin=16)
        t = Gtk.Label(label="More options", xalign=0)
        t.get_style_context().add_class("side-title")
        side.pack_start(t, False, False, 0)
        f = Gtk.Label(label=j.title, xalign=0, ellipsize=3)
        f.get_style_context().add_class("muted")
        side.pack_start(f, False, False, 4)
        grid = Gtk.Grid(row_spacing=10, column_spacing=12)
        self.rot_combo = combo([("auto", "Auto"), ("0", "None"), ("90", "90°"), ("180", "180°"), ("270", "270°")], j.rotate, lambda v: self.set_attr("rotate", v))
        self.margin_combo = combo([("auto", "Auto"), ("0", "None"), ("18", "¼ in"), ("36", "½ in")], j.margin_mode,
                                  lambda v: self.set_attr("margin_mode", v))
        self.bw_combo = combo([("auto", "Auto"), ("sharp", "Sharp (labels)"), ("dither", "Dotted (photos)"), ("off", "Off (colour)")],
                              j.bw, lambda v: self.set_attr("bw", v))
        self.bw_combo.set_tooltip_text("How the page is turned into black and white for a black-only printer.\n"
                                       "The preview shows the exact dots that will print.")
        for i, (lbl, w) in enumerate([("Rotate", self.rot_combo), ("Margin", self.margin_combo),
                                      ("Black & white", self.bw_combo)]):
