                              j.bw, lambda v: self.set_attr("bw", v))
        self.bw_combo.set_tooltip_text("How the page is turned into black and white for a black-only printer.\n"
                                       "The preview shows the exact dots that will print.")
        for i, (lbl, w) in enumerate([("Rotate", self.rot_combo), ("Margin", self.margin_combo),
                                      ("Black & white", self.bw_combo)]):
            grid.attach(Gtk.Label(label=lbl, xalign=0), 0, i, 1, 1)
            w.set_hexpand(True)
            grid.attach(w, 1, i, 1, 1)
        side.pack_start(grid, False, False, 0)
        keys = Gtk.Label(xalign=0)
        keys.set_markup("<small><b>R</b> rotate · <b>F</b> fit/fill · <b>+ −</b> copies\n"
                        "<b>O</b> options · <b>PgUp PgDn</b> pages\n<b>Enter</b> print · <b>Esc</b> cancel</small>")
        keys.get_style_context().add_class("muted")
        side.pack_end(keys, False, False, 0)
        side_wrap.pack_start(side, True, True, 0)
        outer.pack_start(side_wrap, False, False, 0)
        for c in side_wrap.get_children():
            c.show_all()
        if more:
            self.more.set_active(True)
        return outer

    def show_barcodes(self):
        r = self.job.barcodes(self.job.pages[self.job.index])
        if not r:
            self.badge.hide()
        else:
            ok, n = r
            word = "barcode" if n == 1 else "barcodes"
            if ok == n:
                self.badge.set_markup(f"<span foreground='#7fd88f'>✓</span> {n} {word} checked: will scan")
                self.badge.set_tooltip_text("Read back from the exact dots that will print.")
            else:
                self.badge.set_markup(f"<span foreground='#ffb454'>⚠</span> {n - ok} of {n} {word} may not scan")
                self.badge.set_tooltip_text("The image is too low-resolution for this label size.\n"
                                            "Print from the original PDF label if you have it.")
            self.badge.show()
        return False

    # --- printer status ---------------------------------------------------
    def check_printer(self):
        printer = self.job.printer
        if not printer:
            return self.show_warning(False, "No printer is set up.")

        def run():
            ok, msg = printer_status(printer)
            GLib.idle_add(lambda: printer == self.job.printer and self.show_warning(ok, msg))
        threading.Thread(target=run, daemon=True).start()

    def show_warning(self, ok, msg):
        if ok is False:
            self.warn_text.set_text(msg + " It may be off, asleep, or on a new network address.")
            hook = os.access(FIX_HOOK, os.X_OK)
            self.fix_btn.set_label("Find printer" if hook else "Printer settings")
            self.fix_btn.set_visible(hook or shutil.which("system-config-printer") is not None)
            self.warn.show()
        else:
            self.warn.hide()
        return False

    def on_warn(self, _, response):
        if response == 1:
            if os.access(FIX_HOOK, os.X_OK):  # your own fixer; may ask for sudo, so in a terminal
                self.warn_text.set_text("Looking for the printer in the terminal window…")
                cmd = ["xdg-terminal-exec", "bash", "-c",
                       '"$0" "$1"; echo; read -n1 -rsp "Press any key to close…"', FIX_HOOK, self.job.printer]
            else:
                cmd = ["system-config-printer"]

            def run():
                subprocess.run(cmd)
                GLib.idle_add(self.check_printer)
            threading.Thread(target=run, daemon=True).start()
        else:
            self.check_printer()

    # --- settings -----------------------------------------------------------
    def go(self, step):
        n = len(self.job.pages)
        self.job.index = max(0, min(n - 1, self.job.index + step))
        if hasattr(self, "page_label"):
            self.page_label.set_text(f"Page {self.job.index + 1} of {n}")
        self.refresh()

    def show_more(self, on):
        if not self.get_realized():
            return self.side.set_visible(on)
        w, h = self.get_size()
        if on:
            self.base_w = w
            target = w + self.side.get_preferred_width()[1]
        else:
            target = getattr(self, "base_w", self.W)
        self.side.set_visible(on)
        # Resize only after GTK has laid out the new contents; shrinking first
        # makes Hyprland squash the old, wider frame into the narrow window.
        GLib.timeout_add(80, self.hypr_resize, target, h)

    def hypr_resize(self, width, height):
        # Hyprland lets a window grow by itself but not shrink, so ask it directly.
        win = f"pid:{os.getpid()}"
        for cmd in (f'hl.dsp.window.resize({{ window = "{win}", x = {width}, y = {height} }})',  # Lua config
                    f"resizewindowpixel exact {width} {height},{win}"):                       # older Hyprland
            if subprocess.run(["hyprctl", "dispatch", cmd], capture_output=True).returncode == 0:
                return False
        self.resize(width, height)
        return False

    def refresh(self):
        if hasattr(self, "view"):
            self.view.queue_draw()

    def set_printer(self, p):
        self.job.printer = p
        self.job.load_printer()
        self.all_sizes = False
        self.fill_paper()
        self.bw_combo.set_active_id(self.job.bw)
        self.warn.hide()
        self.check_printer()
        self.refresh()

    def fill_paper(self):
        sizes = dict(self.job.sizes)
        common = [n for n in COMMON if n in sizes]
        if self.job.size not in common:
            common.append(self.job.size)
        shown = [n for n, _ in self.job.sizes] if self.all_sizes or len(sizes) <= 12 else common
        self.filling = True
        self.paper.remove_all()
        for name in shown:
            self.paper.append(name, size_label(name, sizes[name]))
        if len(shown) < len(sizes):
            self.paper.append("__other", "Other sizes…")
        self.paper.set_active_id(self.job.size)
        self.filling = False

    def on_paper(self, w):
        if self.filling:
            return
        if w.get_active_id() == "__other":
            self.all_sizes = True
            self.fill_paper()
            GLib.idle_add(self.paper.popup)
            return
        self.set_attr("size", w.get_active_id())

    def set_attr(self, attr, value):
        if value is not None:
            setattr(self.job, attr, value)
            self.refresh()

    def do_print(self, *_):
        if self.job.printer and self.job.print():
            self.destroy()

    def on_key(self, _, ev):
        k = Gdk.keyval_name(ev.keyval)
        if k == "Escape":
            self.destroy()
        elif k in ("Return", "KP_Enter"):
            self.do_print()
        elif k in ("r", "R"):
            order = ["auto", "on", "off"]
            self.rot_combo.set_active_id(order[(order.index(self.job.rotate) + 1) % 3])
        elif k in ("f", "F"):
            self.fit.set_active(not self.fit.get_active())
        elif k in ("o", "O"):
            self.more.set_active(not self.more.get_active())
        elif k in ("plus", "equal", "KP_Add"):
            self.spin.spin(Gtk.SpinType.STEP_FORWARD, 1)
        elif k in ("minus", "KP_Subtract"):
            self.spin.spin(Gtk.SpinType.STEP_BACKWARD, 1)
        elif k in ("Page_Down", "Next"):
            self.go(1)
        elif k in ("Page_Up", "Prior"):
            self.go(-1)
        else:
            return False
        return True


def screenshot(job, more, out):
    win = Window(job, more)
    child = win.get_child()
    win.remove(child)
    off = Gtk.OffscreenWindow()
    off.set_size_request(-1, Window.H)
    win.view.set_size_request(Window.W - 20, -1)
    off.add(child)
    off.show_all()

    def grab():
        off.get_pixbuf().savev(out, "png", [], [])
        Gtk.main_quit()
    GLib.timeout_add(800, grab)
    Gtk.main()


def notify(msg, critical=False):
    subprocess.run(["notify-send", "-a", "Print", *(["-u", "critical"] if critical else []), msg])
    if critical:
        print(msg, file=sys.stderr)


def error(msg):
    notify(msg, critical=True)


def run_inbox(inbox):
    """Show each job the "Preview" printer saved, oldest first, then delete it."""
    work = os.path.join(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()), "print-preview")
    os.makedirs(work, exist_ok=True)
    while True:
        jobs = sorted((os.path.join(inbox, f) for f in os.listdir(inbox) if not f.startswith(".")), key=os.path.getmtime)
        if not jobs:
            return
        path = shutil.move(jobs[0], work)
        title = re.sub(r"\.(pdf|ps|png|jpe?g)$", "", re.sub(r"^\d+-", "", os.path.basename(path)), flags=re.I) or "Document"
        try:
            Window(Job([path], title=title)).show_all()
            Gtk.main()
        except Exception as e:
            error(f"Couldn't open print job {title}: {e}")
        finally:
            os.unlink(path)


def main():
    GLib.set_prgname("print-preview")
    ap = argparse.ArgumentParser(description="Preview images and PDFs before printing them.")
    ap.add_argument("--more", action="store_true", help="open with the options sidebar showing")
    ap.add_argument("--inbox", metavar="DIR", help='show jobs saved by the "Preview" printer, then delete them')
    ap.add_argument("--screenshot", help=argparse.SUPPRESS)
    ap.add_argument("files", nargs="*")
    a = ap.parse_args()
    if a.inbox:
        return run_inbox(a.inbox)
    if not a.files:
        ap.error("give at least one image or PDF")
    try:
        job = Job(a.files)
    except Exception as e:
        return error(f"Can't preview {', '.join(map(os.path.basename, a.files))}: {e}")
    if a.screenshot:
        return screenshot(job, a.more, a.screenshot)
    Window(job, a.more).show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
