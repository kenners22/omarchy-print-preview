#!/usr/bin/env python3
"""print-preview — preview images and PDFs before printing them.

    print-preview [--more] FILE...        preview and print images / PDFs
    print-preview --inbox DIR             open (then remove) jobs the "Preview" printer saved

Opened by imv's Ctrl+P, Files' right-click "Print preview…", "Open with", and
the "Preview" printer in every app's print dialog (install.sh --with-printer).

What you see is what prints: every page is drawn into a PDF at the exact paper
size and sent with `lp -o print-scaling=none`. On black-only (thermal) printers
the page is first rendered at the printer's own dpi and turned into pure black
and white, so the preview shows the real dots and barcodes stay sharp.

Keys: Enter print, Esc cancel, R rotate, F fit/fill, +/- copies, O more options,
Page Up/Down pages.
"""
import argparse, math, os, re, shutil, socket, subprocess, sys, tempfile, threading, time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Poppler", "0.18")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Poppler
import cairo
import numpy as np

NAMED = {"A3": (842, 1191), "A4": (595, 842), "A5": (420, 595), "A5Rotated": (595, 420), "A6": (297, 420),
         "Letter": (612, 792), "Legal": (612, 1008), "Tabloid": (792, 1224), "Executive": (522, 756)}
SPOOL = "/var/spool/print-preview"  # where the "Preview" printer's backend leaves jobs
# Label sizes shown first; a printer's other sizes go under "Other sizes".
COMMON = ["w288h432", "w288h288", "w288h216", "w288h144", "w144h72", "w162h90", "A4", "A5", "A6", "Letter"]
VIRTUAL = {"Preview"}  # our own "Preview" printer: never print back into it


def sh(*cmd):
    """stdout, or None if the command failed or timed out (CUPS can be slow while printers wake)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


# Optional: an executable here makes the offline warning's button run it (with the
# printer name), e.g. a script that re-finds a Wi-Fi printer whose address moved.
FIX_HOOK = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "print-preview", "find-printer")
LAST = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "print-preview", "printer")


def printers():
    """Real printers, and the one to start on: last used, else the CUPS default, else the first."""
    names = [p for p in (sh("lpstat", "-e") or "").split() if p not in VIRTUAL]
    try:
        with open(LAST) as f:
            last = f.read().strip()
    except OSError:
        last = None
    default = (re.search(r"destination: (\S+)", sh("lpstat", "-d") or "") or [None, None])[1]
    for pick in (last, default, names[0] if names else ""):
        if pick in names or pick == "":
            return names, pick
    return names, ""


def remember_printer(printer):
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST, "w") as f:
            f.write(printer + "\n")
    except OSError:
        pass


def media_dims(name):
    """Size in points of a CUPS/IPP paper name: A4, A4.Fullbleed, w288h432, iso_a4_210x297mm, 4x6…"""
    base = re.sub(r"\.[A-Za-z]+$", "", name)  # A4.Fullbleed → A4, but keep 8.5x11in whole
    if base in NAMED:
        return NAMED[base]
    m = re.fullmatch(r"w(\d+(?:\.\d+)?)h(\d+(?:\.\d+)?)", base)
    if m:
        return float(m[1]), float(m[2])
    m = re.search(r"(\d+(?:\.\d+)?)x(\d+(?:\.\d+)?)(mm|in)?$", base)
    if m:
        k = 72 / 25.4 if m[3] == "mm" else 72
        return round(float(m[1]) * k, 2), round(float(m[2]) * k, 2)
    return None


def printer_info(printer):
    """Paper sizes [(cups name, (w, h) pt)], default size, dpi, black-only?"""
    opts = sh("lpoptions", "-p", printer, "-l")
    if not opts:  # couldn't ask CUPS: assume an ordinary colour printer rather than guess "label"
        return [("A4", NAMED["A4"]), ("Letter", NAMED["Letter"])], "A4", 300, False
    sizes, default = [], None
    m = re.search(r"^(?:PageSize|media)/[^:]*:(.*)$", opts, re.M)
    for tok in (m[1].split() if m else []):
        name = tok.lstrip("*")
        dims = media_dims(name)
        if dims and dims[0] > 0 and dims[1] > 0:
            sizes.append((name, dims))
            if tok.startswith("*"):
                default = name
    if not sizes:
        sizes = [("A4", NAMED["A4"])]
    dpi = re.search(r"^(?:Resolution|printer-resolution)/[^:]*:.*\*(\d+)(?:x\d+)?dpi", opts, re.M)
    # Black-only if neither the driver (ColorModel) nor IPP (print-color-mode) offers colour:
    # thermal label printers, mono lasers.
    colour = re.compile(r"(?<![A-Za-z])\*?(RGB|CMYK|CMY|Colou?r|auto)", re.I)
    lines = re.findall(r"^(?:ColorModel|print-color-mode)/[^:]*:(.*)$", opts, re.M)
    mono = not any(colour.search(line) for line in lines)
    return sizes, default or sizes[0][0], int(dpi[1]) if dpi else 300, mono


PORTS = {"socket": 9100, "ipp": 631, "ipps": 631, "http": 80, "https": 443, "lpd": 515}


def printer_status(printer):
    """(ok, message): ok is None when we can't tell (USB, dnssd://, CUPS not answering)."""
    if "disabled" in (sh("lpstat", "-p", printer) or ""):
        return False, f"{printer} is paused in CUPS."
    m = re.search(r"\b(socket|ipps?|https?|lpd)://(\[[0-9A-Fa-f:.]+\]|[^:/\s\[\]]+)(?::(\d+))?", sh("lpstat", "-v", printer) or "")
    if not m:
        return None, ""
    host = m[2].strip("[]")
    try:
        socket.create_connection((host, int(m[3] or PORTS[m[1]])), timeout=2).close()
        return True, ""
    except OSError:
        return False, f"{printer} isn't answering at {host}."


def size_label(name, dims):
    base, _, extra = name.partition(".") if re.search(r"\.[A-Za-z]+$", name) else (name, "", "")
    if base in NAMED:
        return base.replace("Rotated", " landscape") + (f" ({extra.lower()})" if extra else "")
    f = lambda pt: f"{pt / 72:.2f}".rstrip("0").rstrip(".")
    return f"{f(dims[0])} × {f(dims[1])} in"


class ImageSource:
    def __init__(self, pixbuf):
        self.pixbuf = pixbuf
        self.size = (pixbuf.get_width(), pixbuf.get_height())

    def paint(self, cr):
        Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.paint()


class PdfSource:
    def __init__(self, page):
        self.page = page
        self.size = page.get_size()

    def paint(self, cr):
        self.page.render_for_printing(cr)


def load(path):
    with open(path, "rb") as f:
        head = f.read(1024)
    if head.startswith(b"%!"):  # PostScript (some apps print it): convert to PDF first
        fd, pdf = tempfile.mkstemp(prefix="print-preview-", suffix=".pdf")
        os.close(fd)
        try:
            subprocess.run(["ps2pdf", path, pdf], check=True, capture_output=True, timeout=60)
            return load(pdf)
        finally:
            os.unlink(pdf)
    if b"%PDF-" in head:
        # Read into memory so the file can go (the inbox deletes it) while pages are shown.
        with open(path, "rb") as f:
            data = GLib.Bytes.new(f.read())
        doc = Poppler.Document.new_from_bytes(data, None)
        pages = [PdfSource(doc.get_page(i)) for i in range(doc.get_n_pages())]
        if not pages:
            raise ValueError("the PDF has no pages")
        return pages
    return [ImageSource(GdkPixbuf.Pixbuf.new_from_file(path).apply_embedded_orientation())]


BAYER = np.array([[0, 32, 8, 40, 2, 34, 10, 42], [48, 16, 56, 24, 50, 18, 58, 26],
                  [12, 44, 4, 36, 14, 46, 6, 38], [60, 28, 52, 20, 62, 30, 54, 22],
                  [3, 35, 11, 43, 1, 33, 9, 41], [51, 19, 59, 27, 49, 17, 57, 25],
                  [15, 47, 7, 39, 13, 45, 5, 37], [63, 31, 55, 23, 61, 29, 53, 21]]) * 4 + 2


def scan(grey):
    """Barcodes zbarimg reads in a greyscale (0-255) array: [(data, x0, y0, x1, y1)]."""
    if not shutil.which("zbarimg"):
        return None
    h, w = grey.shape
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    a = np.ndarray((h, surf.get_stride() // 4), np.uint32, surf.get_data())[:, :w]
    a[:] = grey.astype(np.uint32) * 0x010101 | 0xFF000000
    surf.mark_dirty()
    fd, png = tempfile.mkstemp(prefix="print-preview-", suffix=".png")
    os.close(fd)
    try:
        surf.write_to_png(png)
        out = subprocess.run(["zbarimg", "-q", "--xml", png], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        os.unlink(png)
    found = []
    for sym in re.findall(r"<symbol\b.*?</symbol>", out, re.S):
        pts = re.search(r"<polygon points='([^']*)'", sym)
        data = re.search(r"<data[^>]*><!\[CDATA\[(.*?)\]\]></data>", sym, re.S)
        if not (pts and data):
            continue
        pts, data = pts[1], data[1]
        xy = [tuple(map(int, p.split(","))) for p in pts.split()]
        xs, ys = [p[0] for p in xy], [p[1] for p in xy]
        found.append((data, min(xs), min(ys), max(xs), max(ys)))
    return found


def keep_barcodes(lum, black):
    """Make every barcode that reads in the grey page still read once it's black and white.

    Squeezing an image onto the printer's dots and cutting it to black/white can
    make bars a dot too fat or thin, enough to stop a barcode scanning. For each
    barcode that broke, try other black/white cut-offs in just its area until it
    reads again. Changes `black` in place; returns (scanning, found) or None.
    """
    want = scan(lum)
    if not want:
        return None
    grey = lambda b: np.where(b, 0, 255).astype(np.uint8)
    have = {d for d, *_ in scan(grey(black)) or []}
    H, W = lum.shape
    for data, x0, y0, x1, y1 in want:
        if data in have:
            continue
        pad = 24  # the quiet zone either side matters to the scanner
        ys, xs = slice(max(0, y0 - pad), min(H, y1 + pad + 1)), slice(max(0, x0 - pad), min(W, x1 + pad + 1))
        for cut in (112, 144, 100, 160, 90, 176, 80, 192):
            trial = lum[ys, xs] < cut
            if data in {d for d, *_ in scan(grey(trial)) or []}:
                black[ys, xs] = trial
                break
    final = {d for d, *_ in scan(grey(black)) or []}  # check the whole page as it will print
    return sum(d in final for d, *_ in want), len(want)


def pick_pages(ranges, n):
    """Page numbers in a CUPS page-ranges value like "1-3,5,8-"."""
    keep = set()
    for part in str(ranges).split(","):
        m = re.fullmatch(r"\s*(\d*)\s*(-?)\s*(\d*)\s*", part)
        if not m or not (m[1] or m[3]):
            continue
        a = int(m[1] or 1)
        b = (int(m[3]) if m[3] else n) if m[2] else a
        keep.update(range(max(1, a), min(n, b) + 1))
    return keep


class Job:
    """Everything the preview and the printout share."""

    def __init__(self, paths, title=None, copies=1, page_ranges=None):
        self.paths = paths
        self.title = title or ", ".join(os.path.basename(p) for p in paths)
        self.pages = [s for p in paths for s in load(p)]
        if page_ranges:  # e.g. "2-3,5" from an app's print dialog
            keep = pick_pages(page_ranges, len(self.pages))
            self.pages = [p for i, p in enumerate(self.pages, 1) if i in keep] or self.pages
        self.index = 0
        self.printers, self.printer = printers()
        self.rotate = "auto"       # auto | 0 | 90 | 180 | 270
        self.scale = "fit"         # fit | fill
        self.margin_mode = "auto"  # auto | points
        self.copies = max(1, min(99, copies))
        self._cache = {}
        self.load_printer()

    def load_printer(self):
        if self.printer:
            self.sizes, self.size, self.dpi, mono = printer_info(self.printer)
        else:
            self.sizes, self.size, self.dpi, mono = [("A4", NAMED["A4"])], "A4", 300, False
        self.bw = "auto" if mono else "off"  # auto (per page) | sharp | dither | off

    def mode(self, src):
        """How this page becomes black and white: sharp, dither or off."""
        if self.bw != "auto":
            return self.bw
        self.raster(src)
        return self._cache[self._key(src)][2]

    @property
    def page(self):
        return dict(self.sizes)[self.size]

    @property
    def margin(self):  # auto: labels (4 in wide or less) edge to edge, paper a quarter inch
        pw, ph = self.page
        m = (0 if min(pw, ph) <= 300 else 18) if self.margin_mode == "auto" else int(self.margin_mode)
        return max(0, min(m, min(pw, ph) / 2 - 9))  # never eat the whole page

    def angle(self, src):
        """Rotation in degrees for this page; auto turns it to match the paper."""
        if self.rotate != "auto":
            return int(self.rotate)
        (iw, ih), (pw, ph) = src.size, self.page
        return 90 if (iw > ih) != (pw > ph) and abs(iw - ih) > 1 else 0

    def rotated(self, src):
        return self.angle(src) in (90, 270)

    def draw_content(self, cr, src):
        """The page at 1 unit = 1 pt, origin top-left, in full colour."""
        pw, ph = self.page
        cr.save()
        cr.rectangle(0, 0, pw, ph)
        cr.set_source_rgb(1, 1, 1)
        cr.fill_preserve()
        cr.clip()
        iw, ih = src.size
        a = self.angle(src)
        ew, eh = (ih, iw) if a in (90, 270) else (iw, ih)
        m = self.margin
        s = (max if self.scale == "fill" else min)((pw - 2 * m) / ew, (ph - 2 * m) / eh)
        if s <= 0:
            return cr.restore()
        cr.translate(pw / 2, ph / 2)
        cr.rotate(math.radians(a))
        cr.scale(s, s)
        cr.translate(-iw / 2, -ih / 2)
        src.paint(cr)
        cr.restore()

    def _key(self, src):
        return (id(src), self.size, self.dpi, self.rotate, self.scale, self.margin, self.bw)

    @property
    def dots(self):
        """The page in printer dots. The PDF page is made exactly this many dots, so one
        image pixel lands on one printer dot even when the paper isn't a whole number of dots."""
        pw, ph = self.page
        return max(1, round(pw * self.dpi / 72)), max(1, round(ph * self.dpi / 72))

    def raster(self, src):
        """The page at the printer's dpi in pure black and white (cached)."""
        key = self._key(src)
        if key not in self._cache:
            W, H = self.dots
            surf = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
            cr = cairo.Context(surf)
            cr.scale(self.dpi / 72, self.dpi / 72)
            self.draw_content(cr, src)
            surf.flush()
            px = np.ndarray((H, surf.get_stride() // 4), np.uint32, surf.get_data())
            v = px[:, :W]
            lum = (((v >> 16) & 255) * 299 + ((v >> 8) & 255) * 587 + (v & 255) * 114) // 1000
            mode = self.bw
            if mode == "auto":  # mostly mid-tones (a photo) looks better as dots; labels stay sharp
                sample = lum[::4, ::4]
                mode = "dither" if ((sample > 40) & (sample < 215)).mean() > 0.3 else "sharp"
            if mode == "dither":
                black = lum < np.tile(BAYER, (H // 8 + 1, W // 8 + 1))[:H, :W]
            else:
                black = lum < 128
            codes = keep_barcodes(lum, black)  # barcodes on a photo-ish page need saving too
            v[:] = np.where(black, 0xFF000000, 0xFFFFFFFF).astype(np.uint32)
            surf.mark_dirty()
            self._cache = {key: (surf, codes, mode)}  # keep just the latest page
        return self._cache[key][0]

    def barcodes(self, src):
        """(scanning, found) for the page as it will print, or None if not checked."""
        if self.bw == "off":
            return None
        self.raster(src)
        return self._cache[self._key(src)][1]

    def draw_page(self, cr, src, preview=False):
        if self.bw == "off":
            return self.draw_content(cr, src)
        cr.save()
        cr.scale(72 / self.dpi, 72 / self.dpi)
        cr.set_source_surface(self.raster(src), 0, 0)
        # On paper every dot stays a dot; on screen smooth it so it isn't jagged.
        cr.get_source().set_filter(cairo.FILTER_GOOD if preview else cairo.FILTER_NEAREST)
        cr.paint()
        cr.restore()

    def write_pdf(self, path):
        pw, ph = self.page
        if self.bw != "off":
            W, H = self.dots
            pw, ph = W * 72 / self.dpi, H * 72 / self.dpi
        surface = cairo.PDFSurface(path, pw, ph)
        cr = cairo.Context(surface)
        for src in self.pages:
            self.draw_page(cr, src)
            cr.show_page()
        surface.finish()

    def print(self):
        fd, pdf = tempfile.mkstemp(prefix="print-preview-", suffix=".pdf")
        os.close(fd)
        try:
            self.write_pdf(pdf)
            r = subprocess.run(["lp", "-d", self.printer, "-n", str(self.copies), "-o", "collate=true",
                                "-o", f"PageSize={self.size}", "-o", "print-scaling=none",
                                "-t", self.title, pdf], capture_output=True, text=True, timeout=120)
            ok, detail = r.returncode == 0, r.stderr.strip()
        except Exception as e:
            ok, detail = False, str(e)
        finally:
            os.unlink(pdf)
        if ok:
            remember_printer(self.printer)
            notify(f"Printing {self.title} on {self.printer}")
        else:
            notify(f"Print failed: {detail}", critical=True)
        return ok


def page_view(job, bg, pad=20):
    """A drawing area that shows the current page centred, scaled to fit, with a soft shadow."""
    area = Gtk.DrawingArea(hexpand=True, vexpand=True)

    def draw(widget, cr):
        W, H = widget.get_allocated_width(), widget.get_allocated_height()
        cr.set_source_rgb(*bg)
        cr.paint()
        pw, ph = job.page
        z = min((W - 2 * pad) / pw, (H - 2 * pad) / ph)
        x, y = (W - pw * z) / 2, (H - ph * z) / 2
        for i, a in ((6, .06), (3, .10), (1, .18)):
            cr.set_source_rgba(0, 0, 0, a)
            cr.rectangle(x - i + 2, y - i + 4, pw * z + 2 * i, ph * z + 2 * i)
            cr.fill()
        cr.translate(x, y)
        cr.scale(z, z)
        job.draw_page(cr, job.pages[job.index], preview=True)
        if area.on_drawn:
            GLib.idle_add(area.on_drawn)

    area.on_drawn = None
    area.connect("draw", draw)
    return area


def combo(items, active, on_change):
    c = Gtk.ComboBoxText()
    for key, label in items:
        c.append(key, label)
    c.set_active_id(active)
    c.connect("changed", lambda w: on_change(w.get_active_id()))
    return c


class Window(Gtk.Window):
    """Minimal by default: page + one row of controls. ⋮ opens a sidebar of more options."""

    W, H, SIDE = 760, 820, 300

    def __init__(self, job, more=False):
        super().__init__(title=f"Print preview — {job.title}")
        self.job = job
        self.all_sizes = False
        self.set_default_size(self.W, self.H)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        css = Gtk.CssProvider()
        css.load_from_data(b".side-title { font-weight: bold; } .muted { opacity: .65; }"
                           b" .pager { background: rgba(0,0,0,.6); border-radius: 8px; padding: 2px 6px; }"
                           b" .pager label { color: #eee; }"
                           b" .badge { background: rgba(0,0,0,.72); color: #eee; border-radius: 8px; padding: 4px 9px; }")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.add(self.build(more))
        self.check_printer()

    def build(self, more):
        j = self.job
        outer = Gtk.Box()
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        self.warn = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING, no_show_all=True)
        self.warn_text = Gtk.Label(xalign=0, wrap=True)
        self.warn.get_content_area().add(self.warn_text)
        self.warn_text.show()
        self.fix_btn = self.warn.add_button("Find printer", 1)
        self.warn.add_button("Check again", 2)
        self.warn.connect("response", self.on_warn)
        main.pack_start(self.warn, False, False, 0)

        ov = Gtk.Overlay()
        self.view = page_view(j, (0.16, 0.16, 0.18))
        self.view.on_drawn = self.show_barcodes
        ov.add(self.view)
        self.badge = Gtk.Label(halign=Gtk.Align.START, valign=Gtk.Align.START, margin=10, no_show_all=True)
        self.badge.get_style_context().add_class("badge")
        ov.add_overlay(self.badge)
        if len(j.pages) > 1:
            pager = Gtk.Box(spacing=4, halign=Gtk.Align.CENTER, valign=Gtk.Align.END, margin_bottom=8)
            pager.get_style_context().add_class("pager")
            prev = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
            nxt = Gtk.Button.new_from_icon_name("go-next-symbolic", Gtk.IconSize.BUTTON)
            for b in (prev, nxt):
                b.set_relief(Gtk.ReliefStyle.NONE)
            prev.connect("clicked", lambda *_: self.go(-1))
            nxt.connect("clicked", lambda *_: self.go(1))
            self.page_label = Gtk.Label()
            pager.pack_start(prev, False, False, 0)
            pager.pack_start(self.page_label, False, False, 0)
            pager.pack_start(nxt, False, False, 0)
            ov.add_overlay(pager)
            self.go(0)
        main.pack_start(ov, True, True, 0)

        bar = Gtk.Box(spacing=6, margin=10)
        self.printer_combo = combo([(p, p) for p in j.printers], j.printer, self.set_printer)
        self.printer_combo.set_tooltip_text("Printer")
        self.paper = Gtk.ComboBoxText(tooltip_text="Paper size")
        self.fill_paper()
        self.paper.connect("changed", self.on_paper)
        self.fit = Gtk.CheckButton(label="Fit whole image", active=j.scale == "fit")
        self.fit.connect("toggled", lambda w: self.set_attr("scale", "fit" if w.get_active() else "fill"))
        self.spin = Gtk.SpinButton.new_with_range(1, 99, 1)
        self.spin.set_value(j.copies)
        self.spin.set_tooltip_text("Copies")
